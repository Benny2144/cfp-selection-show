{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfp-selection-show",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cfp-selection-show-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
