{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfp-selection-show",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "https://cfp-selection-show.benarp2144.workers.dev",
    "GOOGLE_CLIENT_ID": "571029621223-mithc0t7f3act3d7a4r8tagt3jbichv0.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/watch/*", "/join/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfp-selection-show-data",
      "database_id": "3be89ae9-b137-488e-bc60-786d5618bbd6",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cfp-selection-show-media"
    }
  ],
  "triggers": {
    "crons": ["17 5 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
